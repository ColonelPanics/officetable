# Google Chat Webhook URL for match notifications
# Get this from your Google Chat space settings -> Webhooks
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXXXX/messages?key=YYYYY&token=ZZZZZ

# Base URL for the application (used for match links in notifications)
# Example: https://your-app.vercel.app
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app

# Central Alces Bookie bank (the gambling engine's money)
# Service token turns on the bookie mirror ("bank is the truth"):
#ALCES_SERVICE_TOKEN=
# Bank API base URL (defaults to the office bank):
#ALCES_BANK_URL=http://10.151.0.85:3000/api/v1
# House (site bookie) account override — normally generated and stored encrypted:
#ALCES_HOUSE_USER=
#ALCES_HOUSE_PASSWORD=
#
# KEY for encrypting stored bank credentials at rest (bank passwords, house
# password, service token in the settings table). REQUIRED for production:
# any long random string, e.g. `openssl rand -hex 32`. Changing it invalidates
# already-stored credentials (players just re-link their accounts).
#BANK_ENCRYPTION_KEY=